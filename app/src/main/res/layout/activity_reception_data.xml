<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorMildGreen"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbar"
        layout="@layout/toolbar_back"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/padding_6"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- ROW: ICA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/ica"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvIca"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>

        <!-- ROW: SUPPLIER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/supplier"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvSupplier"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>

        <!-- ROW: PIECES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/pieces"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvPieces"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>

        <!-- ROW: VOLUME PIE -->
        <LinearLayout
            android:id="@+id/llVolumePie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/volume_pie"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvVolumePie"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>

        <!-- ROW: GROSS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGrossTitle"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/gross_volume"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvGrossVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>

        <!-- ROW: NET -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_8"
            android:orientation="horizontal">

            <!-- Label -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/exo2_semibold"
                android:gravity="end"
                android:text="@string/net_volume"
                android:textSize="@dimen/text_18" />

            <!-- Colon -->
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="@string/colon"
                android:textSize="@dimen/text_16" />

            <!-- Value -->
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tvNetVolume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/exo2_semibold"
                android:textSize="@dimen/text_18" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/llNoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_nodata" />

        <androidx.appcompat.widget.AppCompatTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_4"
            android:fontFamily="@font/exo2_bold"
            android:letterSpacing="0.02"
            android:text="@string/no_data_available"
            android:textColor="@color/colorBlack"
            android:textSize="@dimen/text_20" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardReception"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardBackgroundColor="@color/colorWhite"
        app:cardCornerRadius="@dimen/corner_radius_10"
        app:cardElevation="@dimen/corner_elevation_8"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <HorizontalScrollView
            android:id="@+id/hsvReceptionData"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ================= HEADER ================= -->
                <LinearLayout
                    android:id="@+id/llDataSquareLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/colorGrey"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_10">

                    <!-- EMPTY (for buttons) -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/thickness"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/width"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/length"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/pieces"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/container"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/volume_pie"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/net_volume"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDataRoundLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@color/colorGrey"
                    android:orientation="horizontal"
                    android:padding="@dimen/padding_10">

                    <!-- EMPTY (for buttons) -->
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/circ"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/length"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/pieces"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/container"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/gross_volume"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/exo2_semibold"
                        android:gravity="center_horizontal"
                        android:text="@string/net_volume"
                        android:textColor="@color/colorCharcoal"
                        android:textSize="@dimen/text_16" />
                </LinearLayout>

                <!-- ================= RECYCLER VIEW ================= -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReceptionData"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:listitem="@layout/row_item_reception_data" />

            </LinearLayout>
        </HorizontalScrollView>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>